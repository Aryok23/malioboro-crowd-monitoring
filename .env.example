# ── Backend ──────────────────────────────────────────────
# Weight file to load at startup — see backend/scripts/benchmark_model.py to
# compare candidates before picking one. Any of the .pt files at repo root.
YOLO_MODEL=yolov8nbest.pt
YOLO_IMGSZ=960

# Optional global fallback alert thresholds — only used for cameras that
# don't define their own "alert_thresholds" in backend/config/cameras.json.
# ALERT_PEOPLE_THRESHOLD=50
# ALERT_VEHICLE_THRESHOLD=30

# Comma-separated list of allowed frontend origin(s) for CORS.
CORS_ORIGIN=http://localhost:5173

# Simple in-memory abuse guards (this is an unauthenticated public demo on a
# 2-OCPU free-tier VM) — not security controls, just anti-hammering limits.
RATE_LIMIT_SWITCH_PER_MIN=20
MAX_WS_CONNECTIONS=5

# DEBUG_SAVE_FRAMES=1

# ── Frontend (Vite) ───────────────────────────────────────
# Baked in at build time (npm run build) — point at the deployed backend.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/active
